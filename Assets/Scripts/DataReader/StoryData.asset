  - id: 2
    name: Story1
    description: "\uB300\uB959\uC758 8\uD560\uC774 \uC5B4\uB460\uC5D0 \uC0BC\uCF1C\uC84C\uACE0,
      \uC778\uB958\uB294 \uC808\uB9DD\uC758 \uB098\uB77D\uC73C\uB85C \uB5A8\uC5B4\uC84C\uB2E4."
  - id: 3
    name: Story1
    description: "\uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uC800\uD56D\uD558\uB358 \uC6A9\uB9F9\uD55C
      \uC790\uB4E4\uB3C4...\uD558\uB098\uB458 \uC4F0\uB7EC\uC838\uAC14\uB2E4."
  - id: 4
    name: Stroy2
    description: "\uADF8\uB54C...\uAE30\uC801\uC774 \uC77C\uC5B4\uB0AC\uB2E4."
  - id: 5
    name: Stroy2
    description: "\uC2E0\uC740 \uB9C8\uC9C0\uB9C9\uAE4C\uC9C0 \uD3EC\uAE30\uD558\uC9C0
